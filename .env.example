# Supabase (див. також QUICK_START.md / SETUP_SUPABASE_CLI.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KeepinCRM (https://keepincrm.com/api-key та https://api.keepincrm.com/)
# Базовий шлях API з /v1, напр. https://api.keepincrm.com/v1
KEEPINCRM_API_KEY=
KEEPINCRM_BASE_URL=https://api.keepincrm.com/v1
# ID етапів угод через кому, які вважаються активними (порожньо — усі завантажені з API потрапляють у синк)
KEEPINCRM_ACTIVE_STAGE_IDS=
# Для перевірки викликів webhook: заголовок x-keepin-webhook-token, query ?token= або поле webhook_secret у JSON-тілі
KEEPINCRM_WEBHOOK_SECRET=
# Витрата при закупівлі сировини (POST /payments): гаманець і категорія
# KEEPINCRM_SUPPLIER_EXPENSE_PURSE_ID=
# KEEPINCRM_SUPPLIER_EXPENSE_PURSE_NAME=Петрович
# KEEPINCRM_SUPPLIER_EXPENSE_CATEGORY_ID=44
# KEEPINCRM_SUPPLIER_EXPENSE_CATEGORY_NAME=Закупівля Кора Сировина
# KEEPINCRM_SUPPLIER_EXPENSE_CURRENCY=UAH
# Переміщення коштів між гаманцями (сторінка «Витрати», webhook /api/webhooks/keepincrm/finances)
# ID опційно — якщо не задано, додаток шукає гаманці за назвами нижче через KeepinCRM API
# KEEPINCRM_FUND_TRANSFER_FROM_PURSE_ID=1
# KEEPINCRM_FUND_TRANSFER_TO_PURSE_ID=7
# KEEPINCRM_FUND_TRANSFER_FROM_PURSE_LABEL=Безготівка
# KEEPINCRM_FUND_TRANSFER_TO_PURSE_LABEL=Петрович
# App → CRM push для transfer (API KeepinCRM поки не приймає POST transfer; за замовчуванням вимкнено)
# KEEPINCRM_FUND_TRANSFER_PUSH_ENABLED=false

CRON_SECRET=

# Telegram алерти (залишок мішків) — старий бот / група
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Telegram Mini App (польовий бот: закупівлі / поїздки)
# Публічний URL застосунку (без слеша в кінці), напр. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
TELEGRAM_BOT_WORK_TOKEN=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Після деплою: POST /api/telegram/setup?token=$CRON_SECRET — реєструє webhook і Menu Button

# OpenAI (ШІ-асистент аналітики на /statistics) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
